{
  "manifest_version": 3,
  "name": "E-TAP — Email Threat Analysis",
  "version": "1.2.0",
  "description": "Experimental Gmail overlay: on-demand Quick Content Check of the visible email text. Nothing is sent until you click Analyze.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "https://*.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "E-TAP Quick Content Check"
  }
}
