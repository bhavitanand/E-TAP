# Copy this file to .env for local development. Never commit .env or real secrets.

# MongoDB
# Local MongoDB Server:
MONGODB_URI=mongodb://localhost:27017/etap
MONGO_DB_NAME=etap
# Set to 1 only for temporary local smoke tests (data is lost on restart).
USE_FAKE_DB=0
AUTO_FALLBACK_DB=0

# External lookups. Keep disabled until keys/privacy behavior are verified.
THREAT_INTEL_LIVE=0
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Optional Gemini analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS: comma-separated exact frontend origins; do not use * in production.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Used by hosting platforms; local backend defaults to 5000.
PORT=5000
